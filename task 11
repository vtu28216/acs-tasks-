import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int R = sc.nextInt();
        int C = sc.nextInt();
        int[][] grid = new int[R][C];
        Queue<int[]> q = new LinkedList<>();
        int trees = 0, minutes = 0;

        for (int i = 0; i < R; i++) {
            for (int j = 0; j < C; j++) {
                grid[i][j] = sc.nextInt();
                if (grid[i][j] == 2)
                    q.add(new int[]{i, j});
                if (grid[i][j] == 1)
                    trees++;
            }
        }

        int[] dr = {-1, 1, 0, 0};
        int[] dc = {0, 0, -1, 1};

        while (!q.isEmpty() && trees > 0) {
            int size = q.size();
            minutes++;

            for (int i = 0; i < size; i++) {
                int[] cell = q.poll();

                for (int d = 0; d < 4; d++) {
                    int nr = cell[0] + dr[d];
                    int nc = cell[1] + dc[d];

                    if (nr >= 0 && nr < R && nc >= 0 && nc < C && grid[nr][nc] == 1) {
                        grid[nr][nc] = 2;
                        trees--;
                        q.add(new int[]{nr, nc});
                    }
                }
            }
        }

        System.out.println("Minutes = " + (trees == 0 ? minutes : -1));
        sc.close();
    }
}
